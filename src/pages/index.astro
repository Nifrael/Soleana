---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Soleana from "../assets/images/Soleana.jpg";
import PrestationsCards from "../components/PrestationsCards.astro";
import MasseuseCard from "../components/MasseuseCard.astro";
import ContactCards from "../components/ContactCards.astro";
import PageHero from "../components/global/PageHero.astro";
import NewsSection from "../components/NewsSection.astro";
import Logo from "../assets/logo.svg";
---

<Layout image={Soleana}>
  <section class="page-content">
    <PageHero
      imageDesktop={Soleana}
      imageMobile={Soleana}
      desktopFocus="center"
      altText="Table de massage préparée dans la cabine de soin"
      title="L'Instant Soleana"
      subtitle="Vous invite"
    >
      <h1 class="titre-logo">
        <Image src={Logo} alt="L'Instant Soleana" id="logo-soleana" />
      </h1>
    </PageHero>
    <NewsSection />
    <PrestationsCards />
    <MasseuseCard />
    <ContactCards />
  </section>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .titre-logo {
    width: 100%;
    margin: 0;
  }

  :global(#logo-soleana) {
    width: 90%;
    max-width: 600px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  @media (width >= $breakpoint-tablet) {
    :global(#logo-soleana) {
      max-width: 650px;
    }
  }

  @media (width >= $breakpoint-desktop-xxl) {
    :global(#logo-soleana) {
      max-width: 750px;
    }
  }

  .page-content {
    padding-bottom: 2rem;
  }
</style>
