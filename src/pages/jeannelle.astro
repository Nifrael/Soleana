---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/global/PageHero.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import BoutonPilule from "../components/ui/BoutonPilule.astro";
import ContactCard from "../components/global/ContactCard.astro";
import Icone, { type NomIcone } from "../components/ui/Icone.astro";
import imageJeannelle from "../assets/images/Jeannelle.jpg";
import { telephone, jeannelle } from "../data/coordonnees";

const infos: {
  icone: NomIcone;
  etiquette: string;
  texte: string;
  lien?: string;
}[] = [
  { icone: "lieu", etiquette: "Adresse", texte: jeannelle.adresse },
  { icone: "calendrier", etiquette: "Quand", texte: jeannelle.horaires },
  {
    icone: "telephone",
    etiquette: "Rendez-vous",
    texte: telephone.affiche,
    lien: telephone.lien,
  },
];
---

<Layout
  title="Chez Jeannelle, à Millas | L'Instant Soleana"
  description="Retrouvez L'Instant Soleana chez Jeannelle, à Millas, pour des soins et des massages sur rendez-vous, près de Perpignan."
  image={imageJeannelle}
>
  <PageHero
    imageDesktop={imageJeannelle}
    imageMobile={imageJeannelle}
    altText="Devanture de l'espace Jeannelle à Millas"
    title="Chez Jeannelle"
    subtitle="Un nouveau lieu de bien-être"
  />

  <div class="page-content">
    <section class="partenariat">
      <SectionHeader
        surtitre="Lieu partenaire"
        titre="Un partenariat naturel"
        description="L'Instant Soleana vous invite chez Jeannelle."
      />
      <p>
        C'est avec une immense joie que je vous annonce l'installation de
        L'Instant Soleana au sein de l'espace <strong>Jeannelle</strong>. Ce
        lieu, empreint de douceur et d'élégance, correspond parfaitement à
        l'esprit de sérénité que je souhaite vous offrir.
      </p>
      <p>
        Ensemble, nous partageons une vision commune du bien-être, où chaque
        détail compte pour vous proposer une expérience unique et ressourçante.
      </p>
    </section>

    <aside class="infos" aria-labelledby="titre-infos">
      <p class="surtitre" id="titre-infos">Infos pratiques</p>
      <ul>
        {
          infos.map((info) => (
            <li>
              <span class="pastille">
                <Icone nom={info.icone} />
              </span>
              <div>
                <p class="etiquette">{info.etiquette}</p>
                {info.lien ? (
                  <a href={info.lien}>{info.texte}</a>
                ) : (
                  <p>{info.texte}</p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </aside>

    <BoutonPilule
      texte="Découvrir Jeannelle"
      href={jeannelle.site}
      icone="boutique"
    />
  </div>
  <ContactCard />
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixins" as *;

  .page-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    width: 90%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 0 4rem;

    :global(.bouton) {
      align-self: center;
    }
  }

  .partenariat {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 40rem;

    p {
      line-height: 1.6;
    }
  }

  .infos {
    width: 100%;
    max-width: 40rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1.5rem;
    background-color: var(--secondary-color);

    .surtitre {
      @include surtitre;
      margin: 0 0 1rem;
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    li {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    p,
    a {
      margin: 0;
      font-family: var(--font-text);
      font-size: var(--base-size);
      color: var(--primary-color);
    }

    a {
      font-weight: 600;
      text-decoration: underline;
      text-decoration-color: var(--accent-color);
      text-underline-offset: 0.2em;
    }

    .etiquette {
      @include surtitre(var(--primary-color));
    }
  }

  @media (hover: hover) and (width >= $breakpoint-desktop) {
    .infos a:hover {
      color: var(--accent-color);
    }
  }

  .pastille {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: var(--tertiary-color);
    color: var(--accent-color);

    :global(.icone) {
      font-size: 1.15rem;
    }
  }
</style>
