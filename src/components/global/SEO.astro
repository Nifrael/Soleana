---
import { getImage } from "astro:assets";
import defaultImage from "../../assets/images/Bienvenue.jpg";
import siteConfig from "../../content/siteConfig.js";
import {
  email,
  horaires,
  localisation,
  praticienne,
  telephone,
} from "../../data/coordonnees";
import { villages } from "../../data/villages";

export interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = defaultImage,
  noindex = false,
} = Astro.props;

const imagePartage = await getImage({
  src: image,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});
const imageEntreprise = await getImage({
  src: defaultImage,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});
const ogImageUrl = new URL(imagePartage.src, Astro.site).toString();

const accueil = new URL("/", Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const donneesStructurees = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${accueil}#site`,
      name: siteConfig.name,
      url: accueil,
      inLanguage: "fr-FR",
    },
    {
      "@type": "HealthAndBeautyBusiness",
      "@id": `${accueil}#entreprise`,
      name: siteConfig.name,
      description: siteConfig.description,
      url: accueil,
      image: new URL(imageEntreprise.src, Astro.site).toString(),
      telephone: telephone.lien.replace("tel:", ""),
      email,
      founder: { "@type": "Person", name: praticienne },
      address: {
        "@type": "PostalAddress",
        streetAddress: localisation.rue,
        addressLocality: localisation.ville,
        postalCode: localisation.codePostal,
        addressRegion: localisation.departement,
        addressCountry: "FR",
      },
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: horaires.joursSemaine,
        opens: horaires.ouverture,
        closes: horaires.fermeture,
      },
      areaServed: villages.map((village) => ({
        "@type": "City",
        name: village,
      })),
    },
  ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" href="/favicon.ico" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}

<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />

<script
  type="application/ld+json"
  set:html={JSON.stringify(donneesStructurees)}
/>
