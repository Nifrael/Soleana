---
import "@styles/global.scss";
import { Font } from "astro:assets";
import Navbar from "../components/global/Navbar.astro";
import Footer from "../components/global/Footer.astro";
import { ClientRouter } from "astro:transitions";
import SEO, { type Props as SEOProps } from "../components/global/SEO.astro";

export interface Props extends SEOProps {}
---

<!doctype html>
<html lang="fr">
  <head>
    <SEO {...Astro.props} />
    <Font cssVariable="--font-title" preload />
    <Font cssVariable="--font-text" preload />
    <Font cssVariable="--font-little-text" />

    <ClientRouter />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
