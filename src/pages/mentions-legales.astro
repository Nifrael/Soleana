---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/global/PageHero.astro";
import Legal from "../assets/images/Legal.jpg";
import LegalDesktop from "../assets/images/LegalDesktop.jpg";
import { email, telephone, adresse } from "../data/coordonnees";
---

<Layout
  title="Mentions légales | L'Instant Soleana"
  description="Mentions légales du site L'Instant Soleana : éditeur, hébergement et propriété intellectuelle."
>
  <PageHero
    imageDesktop={LegalDesktop}
    imageMobile={Legal}
    title="Mentions Légales"
    altText="Image de la section Mentions Légales"
  />
  <div class="page-content">
    <section>
      <h2>Éditeur et responsable de la publication du site</h2>
      <p>
        Le site L'Instant Soleana est édité par Soledad Barranco,
        auto-entrepreneuse dont l'entreprise est domiciliée au{" "}
        {adresse}.
      </p>
      <p>
        L'adresse mail de contact de l'entreprise est
        {email}, également joignable au {telephone.affiche}.
      </p>
      <p>Le SIRET de l'entreprise est le 500 009 899 00021.</p>
    </section>

    <section>
      <h2>Hébergement</h2>
      <p>
        Le site est hébergé par Cloudflare, Inc., située 101 Townsend Street,
        San Francisco, CA 94107, aux États-Unis.
      </p>
      <p>
        Leur site est disponible à l'adresse suivante : <a
          href="https://www.cloudflare.com"
          target="_blank"
          rel="noopener noreferrer">www.cloudflare.com</a
        >.
      </p>
    </section>

    <section>
      <h2>Propriété intellectuelle</h2>
      <p>
        Sauf mention contraire dans les crédits, tous les contenus de ce site
        (textes, images, graphismes, logos...) sont la propriété exclusive de
        Soledad Barranco ou de ses partenaires. Toute reproduction,
        représentation, modification, publication, adaptation de tout ou partie
        des éléments du site, quel que soit le moyen ou le procédé utilisé, est
        interdite, sauf autorisation écrite préalable de l'éditeur.
      </p>
    </section>

    <section>
      <h2>Crédits</h2>
      <p>Conception et réalisation du site : Julien Marchand.</p>
      <p>
        Crédits photos : Toutes les images de sections, sauf les photos
        représentant Soledad Barranco elle-même sont issues de la banque
        d'images libres de droits nommée Unsplash, accessible à l'adresse <a
          href="https://www.unsplash.com"
          target="_blank"
          rel="noopener noreferrer">www.unsplash.com</a
        >.
      </p>
    </section>
  </div>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .page-content {
    margin: 0 auto;
    padding-bottom: 2rem;
    h2 {
      text-align: center;
      padding-top: 2rem;
      font-style: italic;
    }
    p {
      text-align: justify;
      line-height: 1.75rem;
      padding: 1rem 2rem 0rem 2rem;
      color: var(--primary-color);
    }
  }
  .page-content a {
    color: var(--primary-color);
    &:hover {
      text-decoration: underline;
    }
  }

  @media (width >= $breakpoint-desktop) {
    .page-content {
      max-width: 1000px;
    }
  }
</style>
