---
import { Image } from "astro:assets";
import Icone from "../ui/Icone.astro";
import BoutonPilule from "../ui/BoutonPilule.astro";
import LogoMin from "../../assets/logo-min.svg";
import MenuMobile from "./MenuMobile.astro";
import { menuItems, reservation } from "../../data/navigation.js";
---

<header id="main-header">
  <nav>
    <a href="/" id="logo">
      <Image src={LogoMin} alt="L'Instant Soleana" width={60} height={60} />
    </a>
    <div class="desktop-menu">
      {
        menuItems.map((item) =>
          item.subItems ? (
            <div class="has-submenu">
              <button class="submenu-toggle">
                {item.text}
                <Icone nom="chevron" />
              </button>
              <div class="submenu">
                {item.subItems.map((subItem) => (
                  <a href={subItem.href}>{subItem.text}</a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href}>{item.text}</a>
          ),
        )
      }
      <div class="reserver">
        <BoutonPilule
          href={reservation.href}
          texte={reservation.text}
          icone="calendrier"
          clair
        />
      </div>
    </div>
    <MenuMobile />
  </nav>
</header>

<script>
  import { setupMobileMenu } from "../../scripts/Navbar/mobileMenu";
  import { setupSubmenuToggle } from "../../scripts/Navbar/submenuToggle";
  import { setupNavbarScroll } from "../../scripts/Navbar/navbarScroll";

  let cleanupScroll = () => {};

  function initNavbarScripts() {
    const header = document.getElementById("main-header");
    if (header) {
      setupMobileMenu(header);
      setupSubmenuToggle(header);

      if (cleanupScroll) {
        cleanupScroll();
      }
      cleanupScroll = setupNavbarScroll(header);
    }
  }

  document.addEventListener("DOMContentLoaded", initNavbarScripts);
  document.addEventListener("astro:after-swap", initNavbarScripts);
</script>

<style lang="scss">
  @use "@styles/config/variables" as *;

  header {
    width: 100%;
    position: fixed;
    top: 0;
    left: 0;
    background-color: transparent;
    z-index: 100;
    transition:
      background-color 0.2s ease,
      backdrop-filter 0.2s ease,
      box-shadow 0.2s ease;
  }

  header.scrolled {
    background-color: color-mix(in srgb, var(--primary-color) 60%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 4px 10px
      color-mix(in srgb, var(--shadow-color) 8%, transparent);

    nav {
      padding: 0.5rem 0;
    }
  }

  header.menu-ouvert {
    background-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    width: 90%;
    margin: 0 auto;
    z-index: 5;
    transition: padding 0.3s ease;
  }

  #logo {
    display: flex;
    align-items: center;
    position: relative;
    z-index: 20;
    line-height: 0;
  }

  a {
    font-family: var(--font-text);
  }

  .desktop-menu {
    display: none;
  }

  .submenu-toggle {
    color: var(--secondary-color);
    font-family: var(--font-text);
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.4s ease-in-out;
  }

  :global(body.no-scroll),
  :global(html.no-scroll) {
    overflow: hidden;
  }

  @media (width >= $breakpoint-desktop) {
    nav {
      position: relative;
    }

    .desktop-menu {
      position: absolute;
      left: 0;
      right: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2.25rem;
      white-space: nowrap;
    }

    .reserver {
      position: absolute;
      right: 0;
      display: flex;
    }

    .has-submenu {
      position: relative;
    }

    a,
    .submenu-toggle {
      font-size: 1rem;
      letter-spacing: 0.02em;
    }

    .submenu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0;

      @media (hover: hover) {
        &:hover {
          color: var(--tertiary-color);
        }
      }

      :global(.icone) {
        font-size: 0.85rem;
        transition: transform 0.3s ease;
      }
    }

    .has-submenu.open > .submenu {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
    }

    @media (prefers-reduced-motion: reduce) {
      .submenu {
        transition: none;
      }
    }

    .has-submenu.open .submenu-toggle :global(.icone) {
      transform: rotate(180deg);
    }

    .submenu {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: calc(100% + 0.9rem);
      left: 50%;
      transform: translate(-50%, -0.4rem);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.25s ease,
        transform 0.25s ease,
        visibility 0s linear 0.25s;
      align-items: stretch;
      gap: 0.25rem;
      background-color: var(--secondary-color);
      padding: 0.6rem;
      border-radius: 0.75rem;
      box-shadow: 0 8px 24px
        color-mix(in srgb, var(--shadow-color) 12%, transparent);
    }

    .submenu a {
      padding: 0.45rem 0.9rem;
      border-radius: 0.5rem;
      font-size: 0.9rem;
      opacity: 1;
      color: var(--primary-color);

      @media (hover: hover) {
        &:hover {
          background-color: color-mix(
            in srgb,
            var(--primary-color) 8%,
            transparent
          );
          color: var(--primary-color);
        }
      }
    }
  }
</style>
