---
import type { CollectionEntry } from "astro:content";

type PriceTableData =
  CollectionEntry<"prestations">["data"]["priceTables"][number];

interface Props {
  title: PriceTableData["title"];
  items: PriceTableData["prices"];
}

const { title, items } = Astro.props;
---

<section class="price-table">
  <h2>{title}</h2>

  <div class="price-table-grid">
    {
      items.map((item) => (
        <div class="price-item">
          <div class="price-item-header">
            <p class="price-item-name">{item.name}</p>
          </div>
          {item.description && (
            <p class="price-item-description">
              {item.description} <span class="duration">{item.duration}</span>
            </p>
          )}
          <p class="price-item-price">{item.price}</p>
        </div>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .price-table {
    width: 95%;
    max-width: 1200px;
    margin: 0 auto 1rem auto;
  }

  h2 {
    text-align: center;
    color: var(--primary-color);
    position: relative;
    padding-bottom: 1rem;
    margin-top: 0;
    text-decoration: underline;
  }

  .price-table-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .price-item {
    padding: 1rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.25rem 1.5rem;
  }

  .price-item-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .price-item-name {
    font-family: var(--font-text);
    font-size: var(--h5);
    font-weight: 600;
    color: var(--primary-color);
    margin: 0;
  }

  .price-item-description {
    font-family: var(--font-little-text);
    margin: 0;
    color: color-mix(in srgb, var(--primary-color) 75%, transparent);
    font-style: italic;
    text-align: justify;
    font-size: 0.95rem;
    grid-column: 1 / 2;
  }

  .price-item-price {
    justify-self: end;
    grid-column: 2 / 3;
    grid-row: 1 / 3;
    margin: 0;
    white-space: nowrap;
    font-size: var(--h5);
    font-weight: 700;
  }

  .duration {
    color: var(--primary-color);
    font-weight: bold;
  }

  @media (width >= $breakpoint-desktop) {
    .price-table-grid {
      grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
    }
  }
</style>
