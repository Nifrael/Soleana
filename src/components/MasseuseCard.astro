---
import PhotoProfil from "../assets/images/Soledad.jpg";
import FondEau from "../assets/images/Fond-eau.jpg";
import { Image, Picture } from "astro:assets";
import BoutonPilule from "./ui/BoutonPilule.astro";
---

<div class="person-card-container">
  <Picture
    src={FondEau}
    alt=""
    width={2400}
    widths={[800, 1600, 2400]}
    sizes="100vw"
    formats={["avif"]}
    fallbackFormat="webp"
    loading="eager"
    fetchpriority="low"
    class="fond"
  />
  <div class="person-card">
    <Image
      src={PhotoProfil}
      alt="Portrait de Soledad Barranco"
      id="profile-photo"
    />
    <div class="person-card-text">
      <p class="surtitre">Votre praticienne</p>
      <h2 class="nom">Soledad Barranco</h2>
      <p>
        "Passionnée par la beauté au naturel et le bien-être global, je choisis
        d'aller au-delà du simple soin, pour créer de véritables rituels sur
        mesure."
      </p>
      <p class="invitation">
        Je vous invite à en découvrir plus sur moi, si vous le souhaitez.
      </p>
      <BoutonPilule texte="Derrière le soin" href="/apropos/" clair />
    </div>
  </div>
</div>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixins" as *;

  .person-card-container {
    position: relative;
    isolation: isolate;
    clip-path: inset(0);
    margin: 4rem auto;
    width: 100%;
    min-height: 50vh;
    padding: 4rem 1rem;

    :global(.fond) {
      position: absolute;
      inset: 0;
      z-index: -1;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  #profile-photo {
    width: 230px;
    height: 230px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
  }

  .person-card {
    display: grid;
    margin: 0 auto;
    grid-template-columns: 1fr;
    gap: 2rem;
    justify-items: center;
    align-items: center;
    text-align: center;
    h2,
    p {
      color: var(--secondary-color);
    }
  }

  .surtitre {
    @include surtitre(var(--secondary-color));
    margin: 0;
  }

  .invitation {
    font-weight: 600;
  }

  .nom {
    margin-top: 0.25rem;
    font-family: var(--font-title);
    font-size: var(--h2);
    font-weight: 900;
  }

  .person-card-text {
    :global(.bouton) {
      margin-block: 1rem;
    }

    background-color: color-mix(
      in srgb,
      var(--tertiary-color) 25%,
      transparent
    );
    border-radius: 10px;
    backdrop-filter: blur(15px);
    padding: 1rem;
  }

  @media (width >= $breakpoint-tablet) {
    .person-card-container :global(.fond) {
      position: fixed;
    }
  }

  @media (width >= $breakpoint-desktop) {
    .nom {
      font-size: var(--h1);
    }
  }

  @media (width >= $breakpoint-desktop-xxl) {
    .person-card {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      width: 80%;
    }

    #profile-photo {
      width: 450px;
      height: 450px;
    }
  }
</style>
