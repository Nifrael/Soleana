---
// Année du build : le site étant statique, elle se met à jour à chaque déploiement.
const annee = new Date().getFullYear();
---

<footer class="footer-container">
  <div class="footer-content">
    <div class="primary-content">
      <h1>L'Instant Soleana</h1>
      <h5>S'invite chez vous.</h5>
      <nav class="icon-links">
        <!-- <a href="/">Instagram</a> -->
      </nav>
    </div>
    <div class="secondary-content">
      <div class="footer-column">
        <h3>Prestations</h3>
        <nav class="footer-links">
          <a href="/prestations/massages">Massages</a>
          <a href="/prestations/soins">Soins</a>
          <a href="/prestations/epilations">Epilation</a>
          <a href="/prestations/maquillages">Maquillage</a>
          <!-- <a href="/prestations/structures">En Structure</a> -->
        </nav>
      </div>
      <div class="footer-column">
        <h3>Plan du site</h3>
        <nav class="footer-links">
          <a href="/apropos">Derrière le soin</a>
          <a href="/contact">Contact</a>
          <a href="/mentions-legales">Mentions légales</a>
          <a href="/politique-de-confidentialite"
            >Politique de confidentialité</a
          >
        </nav>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {annee} L'Instant Soleana</p>
    <span class="separateur" aria-hidden="true"></span>
    <p>Site réalisé par Julien Marchand - Nifradev</p>
  </div>

  <style lang="scss">
    @use "@styles/config/variables" as *;

    .footer-container {
      width: 100%;
      background-blend-mode: overlay;
      background-image: url("../../assets/footer-background.svg");
      background-position: top;
      background-size: cover;
      color: var(--primary-color);
      padding: 2rem 0 0;
    }

    .footer-content {
      width: 85%;
      margin: 0 auto;
      display: grid;
      grid-template-rows: auto;
      grid-template-columns: 1fr;
    }

    .primary-content {
      display: flex;
      flex-direction: column;
      margin-bottom: 2rem;
      h1 {
        margin: 0 0 1.5rem 0;
      }
      h5 {
        margin: 0.75rem 0;
      }
    }

    .secondary-content {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      a {
        text-decoration: none;
        color: var(--primary-color);
        transition: color 0.3s ease;
      }
    }

    .footer-bottom {
      width: 85%;
      // Même espace au-dessus du trait que sous le haut du footer, puis 1rem de part
      // et d'autre des mentions, comme sur MamCram.
      margin: 2rem auto 0;
      padding-block: 1rem;
      border-top: 1px solid
        color-mix(in srgb, var(--primary-color) 25%, transparent);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      text-align: center;
      p {
        margin: 0;
        font-size: 0.75rem;
        opacity: 0.6;
      }
      // Sur mobile les deux mentions sont empilées : le rond ne sert plus.
      .separateur {
        display: none;
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background-color: currentColor;
        opacity: 0.4;
      }
    }

    @media (width >= $breakpoint-tablet) {
      .footer-bottom {
        flex-direction: row;
        justify-content: center;
        gap: 0.75rem;
        .separateur {
          display: block;
        }
      }
    }

    @media (width >= $breakpoint-desktop) {
      .footer-container {
        padding: 2rem 0 0;
      }
      .footer-links a:hover {
        color: var(--tertiary-color);
      }
    }

    @media (width >= $breakpoint-desktop-xl) {
      .footer-container {
        padding: 4rem 0 0;
      }
      .footer-content {
        grid-template-columns: 60% 40%;
      }
      .footer-bottom {
        margin-top: 4rem;
      }
      .secondary-content {
        flex-direction: row;
      }
    }
  </style>
</footer>
