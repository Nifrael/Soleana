---
import PhotoProfil from "../assets/images/Soledad.jpg";
import { Image } from "astro:assets";
import Button from "./ui/Button.astro";
---

<div class="person-card-container">
  <div class="person-card">
    <Image src={PhotoProfil} alt="Photo de profil" id="profile-photo" />
    <div class="person-card-text">
      <h2 class="nom">Soledad Barranco</h2>
      <p>
        "Passionnée par la beauté au naturel et le bien-être global, je choisis
        d'aller au-delà du simple soin, pour créer de véritables rituels sur
        mesure."
      </p>
      <h5>Je vous invite à en découvrir plus sur moi, si vous le souhaitez.</h5>
      <Button text="Derrière le soin" href="/apropos" variant="secondary" />
    </div>
  </div>
</div>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .person-card-container {
    margin: 4rem auto;
    width: 100%;
    min-height: 50vh;
    background-image: url("/images/Zen.jpg");
    background-color: color-mix(
      in srgb,
      var(--shadow-color) 32.5%,
      transparent
    );
    background-blend-mode: overlay;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 4rem 1rem;
  }

  #profile-photo {
    width: 230px;
    height: 230px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
  }

  .person-card {
    display: grid;
    margin: 0 auto;
    grid-template-columns: 1fr;
    gap: 2rem;
    justify-items: center;
    align-items: center;
    text-align: center;
    h2,
    h5,
    p {
      color: var(--secondary-color);
    }
  }

  // Ex-<h1> (un seul par page, celui de l'accueil) : même apparence.
  .nom {
    font-family: var(--font-title);
    font-size: var(--h2);
    font-weight: 900;
  }

  .person-card-text {
    background-color: color-mix(
      in srgb,
      var(--tertiary-color) 25%,
      transparent
    );
    border-radius: 10px;
    backdrop-filter: blur(15px);
    padding: 1rem;
  }

  @media (width >= $breakpoint-tablet) {
    .person-card-container {
      background-attachment: fixed;
    }
  }

  @media (width >= $breakpoint-desktop) {
    .nom {
      font-size: var(--h1);
    }
  }

  @media (width >= $breakpoint-desktop-xxl) {
    .person-card {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      width: 80%;
    }

    #profile-photo {
      width: 450px;
      height: 450px;
    }
  }
</style>
