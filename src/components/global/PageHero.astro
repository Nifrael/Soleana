---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  imageDesktop: ImageMetadata;
  imageMobile: ImageMetadata;
  altText: string;
  title: string;
  subtitle?: string;
  desktopFocus?: "top" | "center" | "bottom";
}

const {
  imageDesktop,
  imageMobile,
  altText,
  title,
  subtitle,
  desktopFocus = "top",
} = Astro.props;

const photoDesktop = await getImage({
  src: imageDesktop,
  width: Math.min(imageDesktop.width, 1920),
  format: "webp",
});
const photoMobile = await getImage({
  src: imageMobile,
  width: Math.min(imageMobile.width, 1200),
  format: "webp",
});
---

<div class="head-background">
  <picture>
    <source media="(width >= 768px)" srcset={photoDesktop.src} />
    <img
      src={photoMobile.src}
      alt={altText}
      width={photoMobile.attributes.width}
      height={photoMobile.attributes.height}
      class:list={[
        "head-photo",
        {
          "head-photo--centre": desktopFocus === "center",
          "head-photo--bas": desktopFocus === "bottom",
        },
      ]}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="head-text">
    <slot>
      <h1>{title}</h1>
      {subtitle && <p class="sous-titre">{subtitle}</p>}
    </slot>
  </div>
</div>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .head-background {
    position: relative;
    width: 100%;
    min-height: 100vh;
    z-index: -2;
  }

  .head-background::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--shadow-color);
    opacity: 0.45;
    z-index: -1;
  }

  .head-text {
    width: 90vw;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    z-index: 1;
    h1 {
      font-size: 2.5rem;
      margin: 0;
    }
    .sous-titre {
      font-size: 1.4rem;
      font-style: italic;
      font-weight: 400;
      margin: 0.5rem 0 0 0;
    }
    h1,
    .sous-titre {
      color: var(--secondary-color);
    }
  }

  .head-photo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    object-position: top;
    object-fit: cover;
  }

  @media (orientation: landscape) and (width < $breakpoint-tablet) {
    .head-background {
      min-height: auto;
      padding-bottom: 10vh;
    }

    .head-text {
      position: static;
      transform: none;
      padding: 10% 0;
      margin: 0 auto;
    }
  }

  @media (width >= $breakpoint-tablet) {
    .head-photo--centre {
      object-position: center;
    }

    .head-photo--bas {
      object-position: center 70%;
    }

    .head-text {
      h1 {
        font-size: 4rem;
      }
      .sous-titre {
        font-size: 1.7rem;
      }
    }
  }

  @media (width >= $breakpoint-desktop-xxl) {
    .head-text {
      h1 {
        font-size: 6rem;
      }
      .sous-titre {
        font-size: 2rem;
      }
    }
  }
</style>
