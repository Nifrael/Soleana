---
import { Image } from "astro:assets";
import Icone from "./ui/Icone.astro";
import SectionHeader from "./ui/SectionHeader.astro";
import BoutonPilule from "./ui/BoutonPilule.astro";
import { newsData } from "../data/news";

const latestNews = newsData.slice(0, 3);
---

{
  latestNews.length > 0 && (
    <section class="news-section">
      <div class="news-container">
        <SectionHeader surtitre="Moments • Événements" titre="Actualités" />

        <div class="news-grid">
          {latestNews.map((item) => (
            <article class="news-card">
              <div class="card-top">
                <p class="categorie">
                  <Icone nom={item.icone} />
                  {item.categorie}
                </p>
                {item.isNew && <span class="new-badge">Nouveau</span>}
              </div>

              <h3>{item.title}</h3>
              <p class="description">{item.description}</p>

              <figure class="photo">
                <Image src={item.visuel.image} alt={item.visuel.alt} />
                <figcaption>
                  <Icone nom="lieu" />
                  {item.visuel.lieu}
                </figcaption>
              </figure>

              <div class="news-action">
                {item.boutons.map((bouton) => (
                  <BoutonPilule
                    href={bouton.href}
                    texte={bouton.texte}
                    icone={bouton.icone}
                  />
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixins" as *;

  .news-section {
    width: 100%;
    padding: 3rem 0 4rem;
  }

  .news-container {
    width: 90%;
    max-width: 72rem;
    margin: 0 auto;
  }

  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .news-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem;
    border-radius: 1.5rem;
    background-color: var(--secondary-color);

    h3 {
      margin: 0.9rem 0 0.6rem;
      font-family: var(--font-title);
      font-size: var(--h4);
      font-weight: 400;
      line-height: 1.3;
    }
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .categorie {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    @include surtitre;

    :global(.icone) {
      font-size: 1.15rem;
    }
  }

  .new-badge {
    flex-shrink: 0;
    padding: 0.3rem 0.9rem;
    border-radius: 2rem;
    background-color: var(--primary-color);
    color: var(--tertiary-color);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .description {
    margin: 0 0 1.5rem;
    font-size: var(--base-size);
    line-height: 1.6;
  }

  .photo {
    position: relative;
    margin: 0 0 1.5rem;
    overflow: hidden;
    border-radius: 2rem;

    img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }

    figcaption {
      position: absolute;
      inset: auto 0 0 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 2rem 1.5rem 1rem;
      background: linear-gradient(
        transparent,
        color-mix(in srgb, var(--shadow-color) 55%, transparent)
      );
      color: var(--tertiary-color);
      font-family: var(--font-text);
      font-size: 0.85rem;
      font-weight: 500;
    }
  }

  .news-action {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
  }

  @media (width >= $breakpoint-desktop) {
    .news-grid {
      grid-template-columns: none;
      grid-auto-columns: minmax(0, 24rem);
      grid-auto-flow: column;
      justify-content: center;
    }

    .news-card {
      display: grid;
      grid-row: span 5;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
  }
</style>
