---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/global/PageHero.astro";
import PriceTable from "../../components/prestations/PriceTable.astro";
import ContactCard from "../../components/global/ContactCard.astro";
import Villages from "../../components/global/VillagesSansFrais.astro";

export async function getStaticPaths() {
  const prestations = await getCollection("prestations");
  return prestations.map((prestation) => {
    const slug = prestation.id.split(".")[0];
    return {
      params: { slug },
      props: {
        prestationData: prestation.data,
      },
    };
  });
}

const { prestationData } = Astro.props;

const indications = [
  prestationData.professionalDisclaimer,
  prestationData.familyInfo,
].filter((texte) => texte !== undefined);
---

<Layout
  title={`${prestationData.title} à domicile près de Perpignan | L'Instant Soleana`}
  description={prestationData.description}
  image={prestationData.image.src}
>
  <PageHero
    imageDesktop={prestationData.image.src}
    imageMobile={prestationData.image.src}
    altText={prestationData.image.alt}
    title={prestationData.title}
    subtitle={prestationData.subtitle}
  />
  <div class="page-content">
    <div class="ornement">
      <Image src={prestationData.icon.src} alt="" />
    </div>
    <p class="citation">« {prestationData.quote} »</p>

    {
      indications.length > 0 && (
        <aside class="bon-a-savoir" aria-labelledby="titre-bon-a-savoir">
          <p class="surtitre" id="titre-bon-a-savoir">
            Bon à savoir
          </p>
          <ul>
            {indications.map((texte) => (
              <li>{texte}</li>
            ))}
          </ul>
        </aside>
      )
    }

    {
      prestationData.priceTables.map((table) => (
        <PriceTable
          surtitre={prestationData.title}
          title={table.title}
          items={table.prices}
        />
      ))
    }

    {
      prestationData.note && <p class="note">{prestationData.note}</p>
    }

    {prestationData.homeService && <Villages />}
  </div>
  <ContactCard />
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixins" as *;

  .page-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: 90%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem 0 2rem;
  }

  .ornement {
    display: flex;
    align-items: center;
    gap: 0.75rem;

    &::before,
    &::after {
      content: "";
      width: 2rem;
      height: 1px;
      background-color: color-mix(
        in srgb,
        var(--accent-color) 55%,
        var(--secondary-color)
      );
    }

    img {
      width: 1.5rem;
      height: auto;
    }
  }

  .citation {
    max-width: 32rem;
    margin: 0 0 1rem;
    font-family: var(--font-title);
    font-size: var(--h3);
    font-style: italic;
    font-weight: 400;
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
  }

  .bon-a-savoir {
    width: 100%;
    max-width: 40rem;
    margin-bottom: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1.5rem;
    background-color: var(--secondary-color);

    .surtitre {
      @include surtitre;
      margin: 0 0 0.5rem;
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    li {
      position: relative;
      padding-left: 1.1rem;
      font-family: var(--font-text);
      font-size: var(--base-size);
      line-height: 1.5;
      color: var(--primary-color);

      &::before {
        content: "";
        position: absolute;
        top: 0.6em;
        left: 0;
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 50%;
        background-color: var(--accent-color);
      }
    }
  }

  .note {
    max-width: 40rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid
      color-mix(in srgb, var(--accent-color) 30%, transparent);
    font-size: var(--small-text);
    font-style: italic;
    line-height: 1.5;
    text-align: center;
    color: color-mix(in srgb, var(--primary-color) 75%, transparent);
  }
</style>
