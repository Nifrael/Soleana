---
import { WEB3FORMS_CLE } from "astro:env/server";
import BoutonPilule from "../ui/BoutonPilule.astro";
import { prestations as liensPrestations } from "../../data/navigation.js";

// Web3Forms exige une adresse complète pour la redirection après envoi.
const pageMerci = new URL("/contact/merci/", Astro.site).href;

const profils = ["Particulier", "Professionnel"];
// Mêmes intitulés que le menu : une prestation ajoutée au menu apparaît ici aussi.
const prestations = liensPrestations.map((lien) => lien.text);
---

{
  /*
    Web3Forms : le formulaire est envoyé directement à leur service, qui le
    transmet par email puis redirige vers `redirect`.
  */
}
<section class="formulaire-bloc" aria-labelledby="titre-formulaire">
  <p class="surtitre">Formulaire de contact</p>
  <h2 id="titre-formulaire">Partagez vos préférences</h2>
  <p class="intro">
    Renseignez les détails de votre demande afin que Soledad puisse préparer un
    accueil harmonieux adapté à vos attentes.
  </p>

  <form
    class="formulaire"
    method="POST"
    action="https://api.web3forms.com/submit"
  >
    <input type="hidden" name="access_key" value={WEB3FORMS_CLE} />
    <input
      type="hidden"
      name="subject"
      value="Nouvelle demande depuis le site L'Instant Soleana"
    />
    <input type="hidden" name="from_name" value="Site L'Instant Soleana" />
    <input type="hidden" name="redirect" value={pageMerci} />

    {
      /* Champ piège : invisible, coché seulement par les robots. `botcheck` est le nom attendu par Web3Forms. */
    }
    <p class="visually-hidden">
      <label>
        Ne pas cocher cette case
        <input type="checkbox" name="botcheck" tabindex="-1" />
      </label>
    </p>

    <fieldset class="champ">
      <legend>Vous êtes *</legend>
      <div class="options">
        {
          profils.map((profil, index) => (
            <label class="option">
              <input
                type="radio"
                name="profil"
                value={profil}
                checked={index === 0}
              />
              {profil}
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="champ">
      <label for="nom">Nom et prénom *</label>
      {
        /* `name` : nom de l'expéditeur affiché par Web3Forms dans l'email reçu. */
      }
      <input id="nom" name="name" type="text" autocomplete="name" required />
    </div>

    <div class="ligne">
      <div class="champ">
        <label for="email">Adresse email *</label>
        {
          /* `email` est le nom attendu par Web3Forms pour pouvoir répondre directement. */
        }
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="prenom@exemple.fr"
          required
        />
      </div>
      <div class="champ">
        <label for="telephone">Numéro de téléphone *</label>
        <input
          id="telephone"
          name="telephone"
          type="tel"
          autocomplete="tel"
          placeholder="06 00 00 00 00"
          required
        />
      </div>
    </div>

    <fieldset class="champ">
      <legend>Prestation(s) envisagée(s)</legend>
      <div class="options">
        {
          prestations.map((prestation) => (
            <label class="option">
              <input type="checkbox" name="prestations[]" value={prestation} />
              {prestation}
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="champ">
      <label for="message">Votre message *</label>
      <textarea
        id="message"
        name="message"
        rows="4"
        placeholder="Vos envies, vos disponibilités, ou toute précision utile…"
        required></textarea>
    </div>

    <div class="envoi">
      <BoutonPilule texte="Envoyer ma demande" icone="envoyer" />
      <p class="aide">
        Vos coordonnées servent uniquement à vous répondre.{" "}
        <a href="/politique-de-confidentialite">Politique de confidentialité</a>
      </p>
    </div>
  </form>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .formulaire-bloc {
    padding: 2rem 1.5rem;
    border: 1px solid
      color-mix(in srgb, var(--secondary-color) 70%, transparent);
    border-radius: 1.5rem;
    background-color: var(--tertiary-color);
    box-shadow: 0 2px 12px rgb(0 0 0 / 0.04);

    h2 {
      margin: 0.25rem 0 0.5rem;
      font-family: var(--font-title);
      font-size: var(--h4);
      font-weight: 400;
    }
  }

  .surtitre,
  label,
  legend {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .surtitre {
    margin: 0;
    color: var(--accent-color);
  }

  .intro {
    margin: 0 0 1.75rem;
    font-size: var(--base-size);
    line-height: 1.6;
  }

  .formulaire {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ligne {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .champ {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: none;
  }

  label,
  legend {
    color: var(--primary-color);
  }

  legend {
    margin-bottom: 0.3rem;
    padding: 0;
  }

  // Contour assez marqué pour repérer les champs (contraste 3:1 pour les contours).
  input:not([type="radio"], [type="checkbox"]),
  textarea {
    width: 100%;
    padding: 0.55rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--primary-color) 45%, transparent);
    border-radius: 0.6rem;
    background-color: var(--secondary-color);
    color: var(--primary-color);
    font-family: var(--font-text);
    font-size: var(--base-size);

    &::placeholder {
      color: color-mix(in srgb, var(--primary-color) 55%, transparent);
    }

    &:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 2px;
    }

    // :user-invalid ne s'active qu'après une saisie ou une tentative d'envoi.
    &:user-invalid {
      border-color: rgb(168, 50, 50);
    }
  }

  textarea {
    resize: vertical;
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  // Pilules : la vraie case (radio ou checkbox) reste dans le label, invisible,
  // pour le clavier et les lecteurs d'écran. Une fois choisie, la pilule passe
  // à la couleur principale.
  .option {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--primary-color) 30%, transparent);
    border-radius: 2rem;
    background-color: var(--tertiary-color);
    font-family: var(--font-text);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;

    input {
      position: absolute;
      inset: 0;
      margin: 0;
      opacity: 0;
      cursor: pointer;
    }

    &:has(:checked) {
      border-color: var(--primary-color);
      background-color: var(--primary-color);
      color: var(--tertiary-color);
    }

    &:has(:focus-visible) {
      outline: 2px solid var(--primary-color);
      outline-offset: 2px;
    }

    @media (hover: hover) and (width >= $breakpoint-desktop) {
      &:hover:not(:has(:checked)) {
        border-color: var(--primary-color);
      }
    }
  }

  .envoi {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .aide {
    margin: 0;
    font-size: 0.85rem;

    a {
      color: var(--primary-color);
      text-decoration: underline;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (width >= $breakpoint-tablet) {
    .ligne {
      grid-template-columns: repeat(2, 1fr);
    }

    .envoi {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }
  }

  @media (width >= $breakpoint-desktop) {
    .formulaire-bloc {
      padding: 2.5rem 3rem;
    }

    // Sur mobile, on garde 16 px : en dessous, iOS zoome à la saisie.
    input:not([type="radio"], [type="checkbox"]),
    textarea {
      font-size: 0.9rem;
    }
  }
</style>
