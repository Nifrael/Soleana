---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  imageDesktop: ImageMetadata;
  imageMobile: ImageMetadata;
  altText: string;
  title: string;
  subtitle?: string;
}

const { imageDesktop, imageMobile, altText, title, subtitle } = Astro.props;

// <picture> : le navigateur ne télécharge que l'image adaptée à l'écran.
// Avec deux <Image> masquées en CSS, il chargeait les deux.
const photoDesktop = await getImage({ src: imageDesktop, format: "webp" });
const photoMobile = await getImage({ src: imageMobile, format: "webp" });
---

<div class="head-background">
  <picture>
    {/* 768px = $breakpoint-tablet (les variables SCSS ne sont pas lisibles ici). */}
    <source media="(width >= 768px)" srcset={photoDesktop.src} />
    {/* Image principale de la page : chargée tout de suite, en priorité. */}
    <img
      src={photoMobile.src}
      alt={altText}
      width={photoMobile.attributes.width}
      height={photoMobile.attributes.height}
      class="head-photo"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="head-text">
    <slot>
      <h1>{title}</h1>
      {subtitle && <p class="sous-titre">{subtitle}</p>}
    </slot>
  </div>
</div>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .head-background {
    position: relative;
    width: 100%;
    min-height: 100vh;
    z-index: -2;
  }

  .head-background::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: black;
    opacity: 0.3;
    z-index: -1;
  }

  .head-text {
    width: 90vw;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    z-index: 1;
    h1 {
      font-size: 2.5rem;
      margin: 0;
    }
    .sous-titre {
      font-size: 1.4rem;
      font-style: italic;
      font-weight: 400;
      margin: 0.5rem 0 0 0;
    }
    h1,
    .sous-titre {
      color: var(--secondary-color);
    }
  }

  .head-photo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    object-position: top;
    object-fit: cover;
  }

  @media (orientation: landscape) and (width < $breakpoint-tablet) {
    .head-background {
      min-height: auto;
      padding-bottom: 10vh;
    }

    .head-text {
      position: static;
      transform: none;
      padding: 10% 0;
      margin: 0 auto;
    }
  }

  @media (width >= $breakpoint-tablet) {
    .head-text {
      h1 {
        font-size: 4rem;
      }
      .sous-titre {
        font-size: 1.7rem;
      }
    }
  }

  @media (width >= $breakpoint-desktop-xxl) {
    .head-text {
      h1 {
        font-size: 6rem;
      }
      .sous-titre {
        font-size: 2rem;
      }
    }
  }
</style>
