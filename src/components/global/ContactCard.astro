---
import BoutonPilule from "../ui/BoutonPilule.astro";
---

<div class="contact-card">
  <BoutonPilule texte="Contactez-moi" href="/contact/" icone="email" clair />
</div>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .contact-card {
    width: 100%;
    height: 30vh;
    background-image: url("/src/assets/images/Contact.jpg");
    background-color: color-mix(in srgb, var(--shadow-color) 40%, transparent);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    display: flex;
    justify-content: center;
    align-items: center;

    :global(.bouton) {
      align-self: center;
    }
  }

  @media (width >= $breakpoint-tablet) {
    .contact-card {
      background-attachment: fixed;
    }
  }

  @media (width >= $breakpoint-desktop-xxl) {
    .contact-card {
      height: 40vh;
    }
  }
</style>
