---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/global/PageHero.astro";
import imageJeannelle from "../assets/images/Jeannelle.jpg";
import BoutonPilule from "../components/ui/BoutonPilule.astro";
import { telephone } from "../data/coordonnees";
---

<Layout
  title="L'Instant Soleana chez Jeannelle | Partenariat Bien-être"
  description="Retrouvez L'Instant Soleana chez Jeannelle pour des moments de détente exclusifs."
>
  <PageHero
    imageDesktop={imageJeannelle}
    imageMobile={imageJeannelle}
    altText="L'Instant Soleana chez Jeannelle"
    title="CHEZ JEANNELLE"
    subtitle="Un nouveau lieu de bien-être"
  />

  <section class="content-section">
    <div class="event-block">
      <h2>CHEZ JEANNELLE</h2>
      <p class="subtitle">L’Instant Soleana vous invite chez Jeannelle</p>

      <div class="info-banner">
        <p class="date">
          Contactez-moi pour prendre rendez-vous au {telephone.affiche}.
        </p>
        <p class="location">📍 18 rue Lieutenant Basseras, 66170 Millas</p>
      </div>

      <div class="text-block">
        <h2>Un Partenariat Naturel</h2>
        <p>
          C'est avec une immense joie que je vous annonce l'installation de
          L'Instant Soleana au sein de l'espace <strong>Jeannelle</strong>. Ce
          lieu, empreint de douceur et d'élégance, correspond parfaitement à
          l'esprit de sérénité que je souhaite vous offrir.
        </p>
        <p>
          Ensemble, nous partageons une vision commune du bien-être, où chaque
          détail compte pour vous proposer une expérience unique et
          ressourçante.
        </p>
        <div class="button-wrapper">
          <BoutonPilule
            texte="Découvrir Jeannelle"
            href="https://www.jeannelle.me"
            icone="boutique"
          />
        </div>
      </div>
    </div>
  </section></Layout
>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .content-section {
    width: 90%;
    margin: 4rem auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
    color: var(--primary-color);
  }

  .text-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
    h2 {
      text-align: center;
      margin-bottom: 0.5rem;
    }

    p {
      line-height: 1.6;
      text-align: justify;
    }
  }
  .event-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
    background-color: color-mix(
      in srgb,
      var(--tertiary-color) 50%,
      transparent
    );
    border-radius: 15px;
    box-shadow: 0 4px 15px
      color-mix(in srgb, var(--shadow-color) 5%, transparent);

    h2 {
      text-align: center;
      margin-bottom: 0.5rem;
    }

    p {
      line-height: 1.6;
      text-align: justify;
    }
  }

  .event-block {
    background-color: var(--tertiary-color);

    .subtitle {
      text-align: center;
      font-size: 1.2rem;
      font-style: italic;
      margin-bottom: 1rem;
    }

    .info-banner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 2rem;
      background-color: var(--secondary-color);
      padding: 1rem;
      border-radius: 10px;

      .date {
        font-weight: bold;
        color: var(--primary-color);
        margin: 0;
      }

      .location {
        font-size: 1.1rem;
        margin: 0;
      }
    }
  }

  .button-wrapper {
    align-self: center;
    margin-top: 1rem;
  }

  @media (width >= $breakpoint-desktop) {
    .content-section {
      width: 70%;
    }

    .text-block,
    .event-block {
      padding: 3rem;
    }
  }
</style>
