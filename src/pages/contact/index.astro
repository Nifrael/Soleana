---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/global/PageHero.astro";
import Coordonnees from "../../components/contact/Coordonnees.astro";
import FormulaireContact from "../../components/contact/FormulaireContact.astro";
import ContactImage from "../../assets/images/Contact.jpg";
---

<Layout
  title="Contact et réservation | L'Instant Soleana"
  description="Contactez L'Instant Soleana pour un soin ou un massage à domicile près de Perpignan, par téléphone ou via le formulaire. Particuliers et professionnels."
  image={ContactImage}
>
  <PageHero
    imageDesktop={ContactImage}
    imageMobile={ContactImage}
    altText="Image de la section Contact"
    title="Contact"
  />

  <div class="contact-content">
    <Coordonnees />
    <FormulaireContact />
  </div>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .contact-content {
    display: grid;
    gap: 2rem;
    width: 90%;
    max-width: 72rem;
    margin: 3rem auto 4rem;
  }

  @media (width >= $breakpoint-desktop) {
    .contact-content {
      grid-template-columns: 5fr 7fr;
      align-items: start;
      gap: 3rem;
    }
  }
</style>
