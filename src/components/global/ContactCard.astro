---
import { Image } from "astro:assets";
import BoutonPilule from "../ui/BoutonPilule.astro";
import fond from "../../assets/images/Contact.jpg";
---

<div class="contact-card">
  <Image
    src={fond}
    alt=""
    class="fond"
    widths={[480, 960, 1600, 2400]}
    sizes="100vw"
  />
  <BoutonPilule texte="Contactez-moi" href="/contact/" icone="email" clair />
</div>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .contact-card {
    position: relative;
    width: 100%;
    height: 30vh;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--shadow-color) 40%, transparent);
    display: flex;
    justify-content: center;
    align-items: center;

    .fond {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    :global(.bouton) {
      position: relative;
      align-self: center;
    }
  }

  @media (width >= $breakpoint-desktop-xxl) {
    .contact-card {
      height: 40vh;
    }
  }
</style>
