---
import Icone from "../ui/Icone.astro";
import { villages } from "../../data/villages";
---

<details class="villages-container">
  <summary class="villages-summary">
    <span>
      Cliquez ici pour voir la liste des villages où les frais de déplacement
      sont offerts. Pour les villages plus éloignés, nous en parlerons ensemble.
    </span>
    <Icone nom="chevron" />
  </summary>

  <ul class="villages-list">
    {villages.map((village) => <li>{village}</li>)}
  </ul>
</details>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .villages-container {
    margin: 1rem;
    border: 1px solid var(--secondary-color);
    border-radius: 10px;
    padding: 0.5rem 1rem;
    background-color: var(--tertiary-color);
    interpolate-size: allow-keywords;

    &::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.5s ease,
        content-visibility 0.5s allow-discrete;
    }

    &[open]::details-content {
      block-size: auto;
    }

    .villages-summary {
      display: flex;
      align-items: center;
      gap: 1rem;
      cursor: pointer;
      text-align: justify;
      font-weight: 500;
      line-height: 1.2rem;
      font-family: var(--font-text);
      color: var(--primary-color);
      list-style: none;
      align-self: center;

      &::-webkit-details-marker {
        display: none;
      }

      :global(.icone) {
        flex-shrink: 0;
        transition: transform 0.5s ease;
      }
    }

    &[open] .villages-summary :global(.icone) {
      transform: rotate(180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .villages-container::details-content,
    .villages-container .villages-summary :global(.icone) {
      transition: none;
    }
  }

  .villages-list {
    line-height: 1.5rem;
    column-count: 2;
    column-gap: 2rem;
    list-style-type: none;
    padding-left: 0.5rem;
    margin-top: 1rem;
    font-family: var(--font-text);
    color: var(--primary-color);
  }

  @media (width >= $breakpoint-desktop) {
    .villages-list {
      column-count: 4;
    }
  }
</style>
