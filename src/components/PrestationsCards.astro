---
import { Image } from "astro:assets";
import SectionHeader from "./ui/SectionHeader.astro";
import BoutonPilule from "./ui/BoutonPilule.astro";
import MassageIcon from "../assets/icons/massageIcon.svg";
import HandsIcon from "../assets/icons/handsIcon.svg";
import HairIcon from "../assets/icons/hairIcon.svg";
import MakeUpIcon from "../assets/icons/makeupIcon.svg";
import SoinIcon from "../assets/icons/soinsIcon.svg";

const prestations = [
  {
    titre: "Massages Bien-Être",
    description:
      "Découvrez une sélection de massages vous plongeant dans un instant prolongé de bien-être et de détente.",
    icone: MassageIcon,
    lien: "/prestations/massages",
    bouton: "Massages",
  },
  {
    titre: "Soins Bien-Être",
    description:
      "Découvrez une sélection de soins pour prendre soin de vous, de votre corps et plus spécifiquement de votre visage, de vos mains, de vos pieds.",
    icone: HandsIcon,
    lien: "/prestations/soins",
    bouton: "Soins",
  },
  {
    titre: "Epilation",
    description:
      "Une peau douce et soyeuse, sans effort, à l'aide d'une cire professionnelle sélectionnée avec soin.",
    icone: HairIcon,
    lien: "/prestations/epilations",
    bouton: "Epilation",
  },
  {
    titre: "Maquillage",
    description:
      "Un évènement ? Une occasion particulière ? Choisissez la formule adaptée à vos envies.",
    icone: MakeUpIcon,
    lien: "/prestations/maquillages",
    bouton: "Maquillage",
  },
  {
    titre: "Soins énergétiques",
    description:
      "Découvrez mon soin énergétique pour retrouver une santé optimale. Rééquilibrage profond des flux corporels et revitalisation de l'esprit.",
    icone: SoinIcon,
    lien: "/prestations/soins_energetiques",
    bouton: "Soins énergétiques",
  },
];
---

<div class="text-background">
  <div class="text-content">
    <h1>L'Instant Soleana s'invite chez vous.</h1>
    <p>
      Plus besoin de courir ou de vous soucier du monde extérieur. Imaginez une
      bulle de bien-être qui s'installe directement dans le confort de votre
      foyer.
    </p>
    <p>
      Je recrée pour vous un espace de sérénité, avec tout le matériel
      professionnel nécessaire, pour que votre seule préoccupation soit de
      lâcher prise et de savourer l'instant.
    </p>
    <h3>Des soins sur mesure, pour toutes vos envies.</h3>
    <p>
      Que vous ayez besoin d'une relaxation profonde, d'un soin visage pour un
      coup d'éclat ou d'une mise en beauté, je vous accompagne avec une gamme de
      prestations adaptées. Chaque soin est une invitation à prendre du temps
      pour vous.
    </p>
    <p>
      Et pour une flexibilité totale, il est également possible de nous
      retrouver au sein d'établissements partenaires, sélectionnés pour leur
      cadre et leur qualité.
    </p>
  </div>
</div>
<section class="prestations-section">
  <SectionHeader
    surtitre="Carte complète"
    titre="Les Prestations Soleana"
    description="Une alchimie de protocoles holistiques, massages relaxants et soins esthétiques soignés avec rigueur."
  />
  <div class="prestations-grid">
    {
      prestations.map((prestation) => (
        <article class="prestation-card">
          <div class="prestation-texte">
            <span class="pastille">
              <Image src={prestation.icone} alt="" />
            </span>
            <h3>{prestation.titre}</h3>
            <p>{prestation.description}</p>
          </div>
          <div class="prestation-action">
            <BoutonPilule
              href={prestation.lien}
              texte={prestation.bouton}
              pleineLargeur
            />
          </div>
        </article>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;

  .text-background {
    background: url("../assets/background.svg");
    background-position: center;
    background-size: cover;
    width: 100%;
    margin: 0rem auto 2rem;
    padding: 5% 1rem;
  }

  .text-content {
    width: 90%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    h1,
    h3,
    h5,
    p {
      text-align: center;
    }
    p {
      color: var(--primary-color);
    }
  }

  .prestations-section {
    width: 90%;
    max-width: 72rem;
    margin: 3rem auto 4rem;
  }

  .prestations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .prestation-card {
    display: grid;
    grid-template-rows: 1fr auto;
    padding: 1.75rem 1.5rem;
    border: 1px solid
      color-mix(in srgb, var(--secondary-color) 70%, transparent);
    border-radius: 1.5rem;
    background-color: var(--secondary-color);
    box-shadow: 0 2px 12px
      color-mix(in srgb, var(--shadow-color) 3%, transparent);

    h3 {
      margin: 1.25rem 0 0.6rem;
      font-family: var(--font-title);
      font-size: var(--h4);
      font-weight: 400;
    }

    p {
      margin: 0;
      font-size: var(--base-size);
      line-height: 1.6;
    }
  }

  .pastille {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background-color: var(--tertiary-color);

    img {
      width: 1.75rem;
      height: 1.75rem;
    }
  }

  .prestation-action {
    display: flex;
    margin-top: 1.75rem;
  }

  @media (width >= $breakpoint-tablet) {
    .text-background {
      background-attachment: fixed;
    }

    .prestations-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .prestation-card {
      grid-column: span 2;

      &:last-child:nth-child(odd) {
        grid-column: 2 / span 2;
      }
    }
  }

  @media (width >= $breakpoint-desktop) {
    .prestations-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .prestation-card {
      grid-column: span 2;

      &:nth-child(4) {
        grid-column: 2 / span 2;
      }

      &:last-child:nth-child(odd) {
        grid-column: span 2;
      }
    }

    .text-content {
      width: 60%;
      h1,
      h3,
      h5 {
        text-align: center;
      }
    }

    .prestation-card {
      padding: 2rem 2.25rem;
    }
  }
</style>
